# Application Secret Key for session signing
SECRET_KEY=replace-with-a-secure-random-secret-key-12345

# Database Type: 'postgres' or 'mongodb'
DB_TYPE=postgres

# --- PostgreSQL Configuration ---
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/my_auth_db
# (Note: If PostgreSQL is not yet running locally, the app can automatically fall back to SQLite: sqlite:///app.db)

# --- MongoDB Configuration ---
# Format: mongodb://localhost:27017/my_auth_db or a MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/my_auth_db
MONGO_DB_NAME=my_auth_db

# --- Third-party API keys ---
OPENWEATHER_API_KEY=your_openweather_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here
